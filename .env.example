# ─── Model ───────────────────────────────────────────────
OPENAI_API_KEY=
MODEL=gpt-4o-mini

# ─── Arize AX (tracing exporter) ─────────────────────────
# Verified against https://arize.com/docs/ax/integrations/ts-js-agent-frameworks/vercel
ARIZE_API_KEY=ak-...
ARIZE_SPACE_ID=                 # base64 Space ID — app.arize.com → Settings → Space API Keys. Used as the OTLP `arize-space-id` header.
ARIZE_PROJECT_NAME=acv-hackathon-agent
ARIZE_PROJECT_ID=               # base64 Project/Model ID — find it in the Arize URL when viewing your project: app.arize.com/organizations/.../models/<id>/...
# ARIZE_OTLP_ENDPOINT=https://otlp.arize.com/v1/traces   # override for EU / on-prem

# For the `ax` CLI + skills (separate from tracing): ARIZE_SPACE accepts a space NAME or the base64 ID
ARIZE_SPACE=lvoss

# ─── Payments (Coinbase x402) ────────────────────────────
MOCK_PAYMENTS=false              # true → skip x402 (run the agent + AX loop with NO wallet). Set false for real on-chain payment.
X402_NETWORK=base-sepolia
AGENT_WALLET_PRIVATE_KEY=0x...  # LIVE mode only — wallet funded with testnet USDC (Base Sepolia faucet).
RESOURCE_WALLET_ADDRESS=0x...   # LIVE mode only — who gets paid.
X402_FACILITATOR_URL=           # LIVE mode only — Coinbase-hosted facilitator URL.

# ─── Refund worker ───────────────────────────────────────
RESOURCE_WALLET_PRIVATE_KEY=0x...  # payee wallet key — imported into CDP to sign USDC refunds. Must match RESOURCE_WALLET_ADDRESS.
# Refunds are sent via the Coinbase CDP SDK (server-side nonce management). These
# three credentials are required for a real (non-dry-run) refund send:
CDP_API_KEY_ID=                   # CDP Secret API key id   (portal.cdp.coinbase.com → API Keys)
CDP_API_KEY_SECRET=               # CDP Secret API key secret
CDP_WALLET_SECRET=
CRON_SECRET=                       # Vercel Cron auth — set in Vercel project env; sent as `Bearer <CRON_SECRET>`.
WORKER_SECRET=                     # manual trigger secret for POST /api/worker/refunds

# ─── App ─────────────────────────────────────────────────
BASE_URL=http://localhost:3000  # set to your Vercel URL after deploy
